{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "image": "macos-tahoe-26.5-xcode-26.6"
      }
    },
  "production": {
  "autoIncrement": true,
  "pnpm": "10.28.1",
  "android": {
    "buildType": "app-bundle"
  },
  "ios": {
    "distribution": "store",
    "image": "macos-tahoe-26.5-xcode-26.6"
  }
}
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./play-store-key.json",
        "track": "internal"
      }
    }
  }
}
